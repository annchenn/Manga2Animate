
/*

# ---- ALLOW: repo metadata ----
!/.gitignore
!/.env.example
!/README.md
!/requirements.txt

# ---- ALLOW: source & prompts ----
!/src/
!/prompts/
!/few-shot_example/

# ---- ALLOW: paper figure assets ----
!/figures/
!/assets/

# ---- ALLOW: setup for the open-source storyboard/video backends (weights stay outside git) ----
!/opensource_backends/

# ---- ALLOW: MangaEval, the evaluation code shipped with the paper ----
!/mangaeval/

# ---- ALLOW: project page (static site, deployed to Vercel) ----
!/project_page/

# ---- ALLOW: ablation study code (results stay untracked, see below) ----
# !/ablation/

# =====================================================================
# Junk that must stay ignored even inside the allowed folders above.
# (These come last so they override the `!` rules.)
# =====================================================================

__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
*.log

# ablation: track the code / prompt variants / docs, not the generated results
/ablation/_dryrun/
/ablation/_shared/
/ablation/summary*.json
/ablation/summary*.md
/ablation/*/*/
!/ablation/*/prompts/

# benchmark
# vistorybench (vendored, upstream ViStoryBench/vistorybench @ b44ec91)
# /benchmark must be un-ignored first: git never descends into a directory
# excluded by `/*`, so the `!` rule below cannot match without this line.
!/benchmark/
!/benchmark/vistorybench/

# vistorybench's own .gitignore blanket-excludes data/* (pretrain weights ~9G,
# generated outputs, bench_results); dataset/ is re-included there instead --
# a negation here can't win, since that nested .gitignore is read after this one.

# these are results we regenerate locally, not source data -- keep ignored
/benchmark/vistorybench/data/bench_results/ours/
benchmark/vistorybench/data/outputs/ours/
benchmark/vistorybench/note
# build_evaluation_sheet.py's output; regenerate with utils/build_evaluation_sheet.py
/benchmark/vistorybench/evaluation_tsv/
/benchmark/vistorybench/utils/build_evaluation_sheet.py
# upstream demo media (30M: 20M mp4 + 5M teasers), not needed to run the bench
/benchmark/vistorybench/assets/

# AdaFace is its own git repo (upstream submodule, 30M+ incl. a 17M gif).
# Leave it out or `git add` turns it into a broken gitlink; clone it with:
#   git -C benchmark/vistorybench submodule update --init
/benchmark/vistorybench/vistorybench/bench/content/AdaFace/

# never commit real secrets or media
.env
*.mp4
*.mov
*.avi
*.webm
*.ckpt
*.safetensors
*.pth
*.pt
*.bin
# ...except the result videos the project page shows
!/project_page/static/videos/**/*.mp4

# run_bench.sh keeps a .bak of every reference image it converts to jpg
*.bak

# NFS silly-rename leftovers, from deleting a file another process still has open
.nfs*

# scratch scripts for the PA/IA backfill (not part of the pipeline)
benchmark/vistorybench/tmp/
