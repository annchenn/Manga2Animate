# Google Cloud / Vertex AI — the team default. Every Gemini call in the
# script/storyboard pipeline (character description, script, storyboard
# generation, all reviewers) uses Vertex AI whenever GOOGLE_CLOUD_PROJECT below
# is set (src/utils.py::make_genai_client()); requires GCP IAM/billing already
# set up (e.g. `gcloud auth application-default login`).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Fallback: only used when GOOGLE_CLOUD_PROJECT above is empty. A plain API key
# (https://aistudio.google.com/apikey) — no GCP IAM/service-account/billing
# setup needed, useful if you don't have GCP project access.
GEMINI_API_KEY=

# Models
TEXT_MODEL=gemini-3.1-pro-preview
IMAGE_MODEL=gemini-3-pro-image-preview
VIDEO_REVIEW_MODEL=gemini-3.1-pro-preview
VIDEO_GENERATION_MODEL=dreamina-seedance-2-0-260128 # or use wan2.7: wan2.7-i2v

# Pipeline
NUM_SCRIPTS=3
NUM_CLIPS=6
NUM_STORYBOARDS=3
NUM_ITERATIONS=2

# Few-shot examples (currently use 0 and 3 because 2's character description has different order)
EXP1=0
EXP2=3

ARK_API_KEY=          # required for Seedance; Volcengine/ByteDance Ark console: https://console.volcengine.com/ark
IMGBB_API_KEY=        # required for both video models (first-frame hosting); https://api.imgbb.com/
DASHSCOPE_API_KEY=    # required only for wan2.7-i2v; Alibaba Cloud DashScope console: https://dashscope.console.aliyun.com/

# Storyboard backend
STORYBOARD_BACKEND=gemini   # or flux2 — also settable via `run_all.py --storyboard-backend`

# FLUX.2 backend (only read when STORYBOARD_BACKEND=flux2)
FLUX2_CONDA_ENV=sb_diffusers
FLUX2_MODEL_ID=black-forest-labs/FLUX.2-dev
FLUX2_NUM_VARIANTS=3
FLUX2_PANEL_WIDTH=768
FLUX2_PANEL_HEIGHT=640
FLUX2_NUM_INFERENCE_STEPS=28
FLUX2_GUIDANCE_SCALE=4.0
FLUX2_CPU_OFFLOAD=true               # true (default, safe): streams weights CPU<->GPU on demand, works on smaller GPUs, ~1-2 min/image. false: loads the whole bf16 model onto the GPU at once (faster per image, no transfer overhead) but the weights alone are ~95GB -- confirmed to OOM even on a ~97GB card (near-zero headroom left for activations), so only try false on a GPU with real headroom above ~95GB.
FLUX2_WORKER_TIMEOUT=10800          # seconds; generous for first-run HF weight download
FLUX2_HF_TOKEN_FILE=~/.cache/huggingface/token   # fallback if HF_TOKEN unset (HF's own default token location)
# HF_TOKEN=                          # optional: set directly instead of FLUX2_HF_TOKEN_FILE
# FLUX2_HF_HOME=                     # optional: HF cache dir override for the worker subprocess